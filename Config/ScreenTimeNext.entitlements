<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Task 006 — the shared container. The app writes the configuration and the session window;
	     the DeviceActivityMonitor and Shield extensions read them. Without this they are separate
	     processes with separate containers and the shield has nothing to draw from. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.guodominic.screentimenext</string>
	</array>

	<!-- Task 004 — the entitlement the whole enforcement half depends on. Automatic signing could
	     never negotiate it (B-006), so the project signs MANUALLY against a profile generated on
	     the portal, where the capability demonstrably exists. Development use only; SHIPPING still
	     needs the reviewed distribution entitlement (docs/entitlement-request.md). -->
	<key>com.apple.developer.family-controls</key>
	<true/>

	<!-- Task 016 / B-004 — the App ID carries Time Sensitive Notifications too, so the manual
	     profile includes it. Without this key iOS quietly treats `.timeSensitive` as `.active`. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
